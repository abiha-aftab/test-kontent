{
  "version": "1.0.0",
  "name": "@kentico/gatsby-starter-kontent-lumen",
  "description": "Simple starter blogpost portfolio page for Gatsby and Kontent headless CMS.",
  "repository": "git+https://github.com/kentico/gatsby-starter-kontent-lumen",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare-environment": "node scripts/copy-env-template.js",
    "develop": "ENABLE_GATSBY_REFRESH_ENDPOINT=true gatsby develop",
    "develop:offline": "KONTENT_OFFLINE=1 gatsby develop",
    "build": "gatsby build",
    "build:offline": "KONTENT_OFFLINE=1 gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "jest",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "keywords": [
    "gatsby",
    "blog",
    "starter",
    "kontent",
    "headless CMS",
    "CMS"
  ],
  "dependencies": {
    "@kontent-ai/delivery-sdk": "^16.4.8",
    "@kontent-ai/gatsby-components": "10.0.0",
    "@kontent-ai/gatsby-source": "10.0.1",
    "@kontent-ai/smart-link": "^5.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "babel-jest": "^30.5.2",
    "babel-preset-gatsby": "^3.16.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gatsby": "^5.16.1",
    "gatsby-plugin-catch-links": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-sass": "^6.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lost": "^9.0.2",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^3.9.10",
    "sass": "~1.106.1"
  },
  "overrides": {
    "@kontent-ai/gatsby-source": {
      "axios": "^0.34.0"
    }
  }
}
